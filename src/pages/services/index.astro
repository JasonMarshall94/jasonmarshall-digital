---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import PageHero from "@/components/content/PageHero.astro";
import ServiceDiagram, { type DiagramName } from "@/components/ServiceDiagram.astro";
import { getSiteSettings } from "@/lib/sanity";
import {
  breadcrumbNode,
  businessNode,
  graph,
  serviceNode,
} from "@/lib/structuredData";

const settings = await getSiteSettings();
const site = Astro.site!;
const page = await getEntry("pages", "services");
if (!page) throw new Error('Sanity: the "services" page document is missing');
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

// One diagram per card; unknown services fall back to the browser sketch
const cardDiagram: Record<string, DiagramName> = {
  "web-design": "browser",
  "wordpress-development": "editor",
  "custom-development": "pipeline",
  seo: "search",
  "website-maintenance": "checklist",
};

const jsonLd = graph(
  businessNode(settings, site),
  breadcrumbNode([["Services", "/services/"]], site),
  ...services.map((s) =>
    serviceNode(
      {
        name: s.data.title,
        description: s.data.summary,
        path: `/services/${s.data.slug}/`,
      },
      settings,
      site,
    ),
  ),
);
---

<BaseLayout
  title={page.data.seo?.title ?? `${page.data.title} — ${settings.title}`}
  description={page.data.seo?.description ?? page.data.intro ?? undefined}
  jsonLd={jsonLd}
>
  <Nav page="page" />
  <main id="main-content">
    <PageHero
      heading={page.data.heading}
      subline="Design, development, SEO and ongoing support"
      intro={page.data.intro}
      breadcrumbs={[{ label: "Services" }]}
    />

    <section class="border-line border-b">
      <div class="container pt-18 pb-28 max-[720px]:pt-12 max-[720px]:pb-16">
        <div class="bg-line border-line grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-px border">
          {
            services.map((s) => (
              <a
                href={`/services/${s.data.slug}/`}
                class="group bg-card text-text flex flex-col gap-3.5 p-8 max-[720px]:p-6"
              >
                <figure class="border-line bg-deep m-0 mb-2.5 border p-5 max-[720px]:p-3.5">
                  <ServiceDiagram name={cardDiagram[s.data.slug] ?? "browser"} />
                </figure>
                <h2 class="mt-1.5 mb-0 text-2xl font-medium tracking-[-0.01em]">{s.data.title}</h2>
                <p class="text-body m-0 text-[15px] leading-[1.65]">{s.data.summary}</p>
                <span class="link-more mt-auto pt-3">Learn more →</span>
              </a>
            ))
          }
          <a href="/contact/" class="band group flex flex-col gap-3.5 p-8 max-[720px]:p-6">
            <figure class="border-line bg-deep m-0 mb-2.5 border p-5 max-[720px]:p-3.5">
              <ServiceDiagram name="bubbles" />
            </figure>
            <div class="label">Not sure yet?</div>
            <h2 class="m-0 text-2xl font-medium tracking-[-0.01em]">Let's figure it out together.</h2>
            <p class="text-body m-0 text-[15px] leading-[1.65]">
              Tell me about your business and goals, and I'll recommend the right mix for your
              budget.
            </p>
            <span class="link-more mt-auto pt-3">Start a conversation →</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
