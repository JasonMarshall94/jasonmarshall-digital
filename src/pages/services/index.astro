---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import PageHero from "@/components/content/PageHero.astro";
import RichText from "@/components/content/RichText.astro";
import CallToAction from "@/components/CTA.astro";
import { getSiteSettings } from "@/lib/sanity";
import {
  breadcrumbNode,
  businessNode,
  graph,
  serviceNode,
} from "@/lib/structuredData";

const settings = await getSiteSettings();
const site = Astro.site!;
const page = await getEntry("pages", "services");
if (!page) throw new Error('Sanity: the "services" page document is missing');
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = graph(
  businessNode(settings, site),
  breadcrumbNode([["Services", "/services/"]], site),
  ...services.map((s) =>
    serviceNode(
      {
        name: s.data.title,
        description: s.data.summary,
        path: `/services/${s.data.slug}/`,
      },
      settings,
      site,
    ),
  ),
);
---

<BaseLayout
  title={page.data.seo?.title ?? `${page.data.title} — ${settings.title}`}
  description={page.data.seo?.description ?? page.data.intro ?? undefined}
  jsonLd={jsonLd}
>
  <Nav page="page" />
  <main id="main-content">
    <PageHero
      heading={page.data.heading}
      intro={page.data.intro}
      breadcrumbs={[{ label: "Services" }]}
    />

    <section class="py-16 md:py-24">
      <div class="container">
        <RichText value={page.data.body} class="mb-16" />

        <div
          class="bg-border border-border grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-px border"
        >
          {
            services.map((s, i) => (
              <a
                href={`/services/${s.data.slug}/`}
                class="group bg-card hover:bg-text/[0.025] flex flex-col px-8 py-[2.4rem] no-underline transition-colors duration-200"
              >
                <span class="text-med-grey mb-[1.6rem] text-[0.72rem] tracking-[0.12em]">
                  / {String(i + 1).padStart(2, "0")}
                </span>
                <h2 class="text-text m-0 mb-4 text-[1.5rem] font-medium tracking-[-0.01em]">
                  {s.data.title}
                </h2>
                <p class="text-accent m-0 mb-8 text-[0.9rem] leading-[1.65]">
                  {s.data.summary}
                </p>
                <span class="text-light-grey group-hover:text-text mt-auto inline-flex items-center gap-[0.4rem] text-[0.75rem] tracking-[0.08em] uppercase transition-colors duration-200">
                  Learn more
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-300 group-hover:translate-x-0.5"
                  >
                    →
                  </span>
                </span>
              </a>
            ))
          }
          <a
            href="/contact/"
            class="group bg-card hover:bg-text/[0.025] flex flex-col px-8 py-[2.4rem] no-underline transition-colors duration-200"
          >
            <span class="label mb-[1.6rem] text-[0.66rem]">Not sure yet?</span>
            <h2 class="text-text m-0 mb-4 text-[1.5rem] font-medium tracking-[-0.01em]">
              Let's figure it out together
            </h2>
            <p class="text-accent m-0 mb-8 text-[0.9rem] leading-[1.65]">
              Tell me about your business and goals, and I'll recommend the
              right mix of services for your budget.
            </p>
            <span class="text-light-grey group-hover:text-text mt-auto inline-flex items-center gap-[0.4rem] text-[0.75rem] tracking-[0.08em] uppercase transition-colors duration-200">
              Start a conversation
              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-0.5"
              >
                →
              </span>
            </span>
          </a>
        </div>

        <CallToAction />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
