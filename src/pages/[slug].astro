---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import PageHero from "@/components/content/PageHero.astro";
import RichText from "@/components/content/RichText.astro";
import { getSiteSettings } from "@/lib/sanity";
import { breadcrumbNode, businessNode, graph } from "@/lib/structuredData";

// Sanity "page" documents at /<slug>/.
export const getStaticPaths = (async () => {
  // These slugs have their own routes (getStaticPaths can't see outer scope)
  const RESERVED = new Set(["services", "projects", "contact", "privacy", "404"]);
  const pages = await getCollection("pages");
  return pages
    .filter((p) => !RESERVED.has(p.data.slug))
    .map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const p = page.data;
const settings = await getSiteSettings();
const site = Astro.site!;

const jsonLd = graph(
  businessNode(settings, site),
  breadcrumbNode([[p.title, `/${p.slug}/`]], site),
);
---

<BaseLayout
  title={p.seo?.title ?? `${p.title} — ${settings.title}`}
  description={p.seo?.description ?? p.intro ?? undefined}
  jsonLd={jsonLd}
>
  <Nav page="page" />
  <main id="main-content">
    <PageHero heading={p.heading} intro={p.intro} breadcrumbs={[{ label: p.title }]} />
    <section class="py-16 md:py-24">
      <div class="container">
        <RichText value={p.body} />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
