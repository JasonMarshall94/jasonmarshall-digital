---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import PageHero from "@/components/content/PageHero.astro";
import RichText from "@/components/content/RichText.astro";
import Contact from "@/components/Contact.astro";
import { getSiteSettings } from "@/lib/sanity";
import {
  breadcrumbNode,
  businessNode,
  contactPageNode,
  graph,
} from "@/lib/structuredData";

const settings = await getSiteSettings();
const site = Astro.site!;
const page = await getEntry("pages", "contact");
if (!page) throw new Error('Sanity: the "contact" page document is missing');
const p = page.data;

const jsonLd = graph(
  businessNode(settings, site),
  breadcrumbNode([[p.title, "/contact/"]], site),
  contactPageNode("/contact/", site),
);
---

<BaseLayout
  title={p.seo?.title ?? `${p.title} — ${settings.title}`}
  description={p.seo?.description ?? p.intro ?? undefined}
  jsonLd={jsonLd}
>
  <Nav page="page" />
  <main id="main-content">
    <PageHero heading={p.heading} intro={p.intro} breadcrumbs={[{ label: p.title }]} />
    <Contact heading={false} />
    {
      p.body?.length ? (
        <section class="pb-20 md:pb-32">
          <div class="container">
            <RichText value={p.body} />
          </div>
        </section>
      ) : null
    }
  </main>
  <Footer contactBand={false} />
</BaseLayout>
