---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
---

<BaseLayout
  title="404 — Page Not Found · Jason Marshall Digital"
  description="The page you're looking for doesn't exist."
  noindex
>
  <div class="flex min-h-svh flex-col">
    <Nav page="page" />
    <main id="main-content" class="flex flex-1 flex-col">
      <section
        class="relative flex flex-1 flex-col overflow-hidden pt-16 pb-24 md:pt-24"
      >
        <div class="gridlines"></div>
        <div class="relative container">
          <div class="label float-in mb-12" style="animation-delay: 0.05s">
            404 — Page not found
          </div>

          <h1
            class="text-text float-in m-0 text-[clamp(44px,6vw,80px)] leading-none font-medium tracking-[-0.04em]"
            style="animation-delay: 0.15s"
          >
            Nothing here.<span
              aria-hidden="true"
              class="blink bg-signal ml-[0.08em] inline-block h-[0.82em] w-[0.5em] align-[-0.06em]"
            ></span>
          </h1>

          <p
            class="text-body float-in mt-8 mb-0 max-w-[540px] text-lg leading-[1.65]"
            style="animation-delay: 0.28s"
          >
            That page doesn't exist or may have moved. Head back home or start a project.
          </p>

          <div
            class="float-in mt-12 flex flex-wrap gap-4"
            style="animation-delay: 0.4s"
          >
            <a href="/" class="btn btn-primary">
              Back to home <span aria-hidden="true">↑</span>
            </a>
            <a href="/contact/" class="btn">
              Start a project <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer contactBand={false} />
  </div>
</BaseLayout>
