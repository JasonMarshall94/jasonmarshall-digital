---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import { getSiteSettings } from "@/lib/sanity";

const settings = await getSiteSettings();
const { email } = settings;

// Update this whenever the policy text changes.
const lastUpdated = "October 13, 2026";
---

<BaseLayout
  title={`Privacy Policy — ${settings.title}`}
  description="How Jason Marshall Digital collects, uses and protects information when you visit jasonmarshall.digital or use its contact form."
>
  <Nav page="page" />
  <main id="main-content">
    <section class="border-border relative overflow-hidden border-b pt-30 pb-16 md:pt-40">
      <div class="gridlines"></div>
      <div class="relative z-2 container">
        <div class="label float-in mb-8 flex items-center gap-[0.6rem]">
          <a href="/" class="text-light-grey">
            ← Home
          </a>
          <span class="text-med-grey">/</span>
          <span>Legal / Privacy</span>
        </div>
        <h1
          class="text-text float-in m-0 text-[clamp(2.4rem,6vw,4.8rem)] leading-[1.02] font-medium tracking-[-0.03em]"
          style="animation-delay: 0.1s"
        >
          Privacy Policy.
        </h1>
        <p
          class="text-light-grey float-in mt-8 mb-0 text-[0.82rem] tracking-[0.08em] uppercase"
          style="animation-delay: 0.2s"
        >
          Last updated {lastUpdated}
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container">
        <div class="text-accent max-w-[76ch] text-[0.95rem] leading-[1.8] [&_a]:text-text [&_a]:underline [&_a]:underline-offset-4 [&_h2]:text-text [&_h2]:mt-16 [&_h2]:mb-5 [&_h2]:scroll-mt-28 [&_h2]:text-[1.35rem] [&_h2]:font-medium [&_h2]:tracking-[-0.01em] [&_h3]:text-text [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-base [&_h3]:font-medium [&_li]:mb-2 [&_p]:mb-4 [&_strong]:text-text [&_strong]:font-medium [&_ul]:mb-6 [&_ul]:pl-5">
          <p>
            This policy explains what information Jason Marshall Digital (“we”,
            “us”) collects when you visit <strong>jasonmarshall.digital</strong>{" "}
            or contact us through it, how that information is used, and the
            choices you have. Jason Marshall Digital is a web design and
            development business run by Jason Marshall in Philadelphia,
            Pennsylvania, USA.
          </p>
          <p>
            This policy covers this website only. Websites we build for clients
            have their own privacy policies.
          </p>

          <div class="border-border bg-card my-10 border p-6 md:p-8">
            <p class="label mb-4">The short version</p>
            <ul class="mb-0! list-none pl-0!">
              <li>
                → There are no user accounts, payments or newsletters on this
                site.
              </li>
              <li>
                → If you use the contact form, your details are emailed to us so
                we can reply. They are not stored in a website database.
              </li>
              <li>
                → We use Google Analytics (which sets cookies) and Cloudflare
                Web Analytics (which does not) to understand how the site is
                used.
              </li>
              <li>→ We do not sell your personal information.</li>
              <li>
                → You can ask us to access, correct or delete your information
                at any time.
              </li>
            </ul>
          </div>

          <h2 id="information-we-collect">1. Information we collect</h2>

          <h3>Information you give us</h3>
          <p>
            When you send a project brief through the contact form, we collect:
          </p>
          <ul>
            <li>your name and email address;</li>
            <li>the project type and budget range you select; and</li>
            <li>anything you write in the project details field.</li>
          </ul>
          <p>
            If you email or call us directly, we receive the information you
            choose to share, such as your email address, phone number and the
            contents of your message.
          </p>

          <h3>Information collected automatically</h3>
          <ul>
            <li>
              <strong>Analytics.</strong> Google Analytics collects information
              about your visit, such as the pages you view, how you arrived at
              the site, your approximate location (derived from your IP
              address), your device, browser and screen size, and how you
              interact with pages. Cloudflare Web Analytics collects similar
              visit information in aggregate without using cookies.
            </li>
            <li>
              <strong>Spam and abuse protection.</strong> The contact form is
              protected by Cloudflare Turnstile, which analyses technical
              signals from your browser and device (including your IP address)
              to tell people apart from bots. It loads only after you start
              using the form.
            </li>
            <li>
              <strong>Server logs.</strong> Like most websites, our hosting and
              network providers automatically record technical details of each
              request, such as IP address, browser type, the page requested and
              the time, to deliver the site and protect it from attacks.
            </li>
          </ul>

          <h3>Information stored on your device</h3>
          <ul>
            <li>
              <strong>Theme preference.</strong> If you switch between light and
              dark mode, your choice is saved in your browser’s local storage so
              the site remembers it. It never leaves your device.
            </li>
            <li>
              <strong>Analytics cookies.</strong> Google Analytics sets cookies
              (named <code>_ga</code> and <code>_ga_*</code>) to recognise
              repeat visits. See <a href="#cookies">Cookies</a> below.
            </li>
          </ul>
          <p>
            We do not knowingly collect sensitive information (such as health,
            financial or government ID details). Please do not include it in the
            contact form.
          </p>

          <h2 id="how-we-use">2. How we use your information</h2>
          <ul>
            <li>
              to reply to your enquiry, prepare quotes and provide the services
              you ask for;
            </li>
            <li>
              to understand how visitors use the site so we can improve it;
            </li>
            <li>
              to keep the site and contact form secure and free of spam; and
            </li>
            <li>to meet legal, tax and accounting obligations.</li>
          </ul>
          <p>
            If you are in the European Economic Area or the United Kingdom, we
            rely on these legal bases: taking steps at your request before
            entering into a contract (responding to enquiries); our legitimate
            interests in running, improving and securing the website; your
            consent where the law requires it; and compliance with legal
            obligations.
          </p>

          <h2 id="service-providers">3. Service providers we use</h2>
          <p>
            We use a small number of trusted providers to run this website. They
            process information on our behalf and only for the purposes
            described here:
          </p>
          <ul>
            <li>
              <strong>Netlify</strong> hosts the website and runs the code that
              processes contact form submissions.
            </li>
            <li>
              <strong>Cloudflare</strong> provides network delivery and
              security, Turnstile spam protection, email address protection and
              Cloudflare Web Analytics.
            </li>
            <li>
              <strong>Google</strong> provides Google Analytics.
            </li>
            <li>
              <strong>Resend</strong> delivers contact form submissions to our
              inbox by email.
            </li>
            <li>
              <strong>Our email provider</strong> stores the emails we receive,
              including form submissions.
            </li>
            <li>
              <strong>Sanity</strong> manages the website’s content and serves
              its images. Your browser requests images directly from Sanity’s
              content delivery network, which receives standard request
              information such as your IP address. Contact form submissions are
              not sent to Sanity.
            </li>
          </ul>

          <h2 id="sharing">4. How we share information</h2>
          <p>
            We do not sell your personal information, and we do not share it
            with third parties for their own marketing. Beyond the service
            providers above, we only disclose information if required by law, to
            protect our rights or the safety of others, or as part of a business
            transfer such as a merger or sale, in which case this policy would
            continue to apply.
          </p>

          <h2 id="cookies">5. Cookies and your choices</h2>
          <p>
            The only cookies this site sets are Google Analytics cookies, used
            to measure visits. The site works fully without them. You can:
          </p>
          <ul>
            <li>block or delete cookies in your browser settings;</li>
            <li>
              install the{" "}
              <a
                href="https://tools.google.com/dlpage/gaoptout"
                target="_blank"
                rel="noopener noreferrer"
              >
                Google Analytics opt-out add-on
              </a>
              ; or
            </li>
            <li>use a browser or extension that blocks analytics scripts.</li>
          </ul>
          <p>
            Some browsers send “Do Not Track” signals. Because there is no
            common standard for them, the site does not currently change its
            behaviour in response.
          </p>

          <h2 id="retention">6. How long we keep information</h2>
          <ul>
            <li>
              <strong>Enquiries:</strong> kept in our email for as long as
              needed to respond and, if we work together, for the length of the
              project and the period required for tax and accounting records.
              Enquiries that do not lead to work are deleted within 3 years.
            </li>
            <li>
              <strong>Analytics:</strong> retained by Google Analytics for 14
              months, after which detailed data is deleted automatically.
            </li>
            <li>
              <strong>Server and security logs:</strong> kept by our providers
              for short periods under their own retention policies.
            </li>
          </ul>

          <h2 id="your-rights">7. Your rights</h2>
          <p>
            Depending on where you live, you may have the right to access the
            personal information we hold about you, correct it, delete it,
            receive a copy, object to or restrict how we use it, and withdraw
            consent. To make a request, email{" "}
            <a href={`mailto:${email}`}>{email}</a>. We will respond within 30
            days and may need to confirm your identity first. We will never
            treat you differently for exercising your rights.
          </p>
          <p>
            If you are in the EEA or UK, you also have the right to complain to
            your local data protection authority.
          </p>

          <h2 id="security">8. Security</h2>
          <p>
            The site is served only over encrypted HTTPS connections, the
            contact form is protected against automated abuse, and access to our
            accounts is restricted. No method of transmission or storage is
            completely secure, but we take reasonable steps to protect your
            information.
          </p>

          <h2 id="international">9. International visitors</h2>
          <p>
            We are based in the United States, and our service providers may
            process information in the United States and other countries. If you
            visit from outside the US, your information will be transferred to
            and processed in countries whose data protection laws may differ
            from yours.
          </p>

          <h2 id="children">10. Children</h2>
          <p>
            This website is intended for businesses and adults. We do not
            knowingly collect personal information from children under 16. If
            you believe a child has sent us information, contact us and we will
            delete it.
          </p>

          <h2 id="other-sites">11. Links to other websites</h2>
          <p>
            This site links to client websites in our portfolio and to GitHub.
            Those sites are run by others and have their own privacy practices,
            which this policy does not cover.
          </p>

          <h2 id="changes">12. Changes to this policy</h2>
          <p>
            We may update this policy when the website or our practices change.
            The date at the top of the page shows when it was last revised.
          </p>

          <h2 id="contact">13. Contact us</h2>
          <p>
            Questions or requests about this policy or your information:
            <br />
            <strong>Jason Marshall Digital</strong>
            <br />
            Philadelphia, PA, USA
            <br />
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
