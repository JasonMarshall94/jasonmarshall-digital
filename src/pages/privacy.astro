---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import { getSiteSettings } from "@/lib/sanity";

const settings = await getSiteSettings();
const { email } = settings;
const location = [settings.city, settings.region].filter(Boolean).join(", ");

// Update this whenever the policy text changes.
const lastUpdated = "October 25, 2026";
---

<BaseLayout
  title={`Privacy Policy — ${settings.title}`}
  description="How Jason Marshall Digital collects, uses and protects information when you visit jasonmarshall.digital or use its contact form."
>
  <Nav page="page" />
  <main id="main-content">
    <section class="border-line relative overflow-hidden border-b pt-12 pb-16">
      <div class="gridlines"></div>
      <div class="relative z-2 container">
        <div class="label float-in mb-8 flex items-center gap-[0.6rem]">
          <a href="/" class="text-light-grey">
            ← Home
          </a>
          <span class="text-med-grey">/</span>
          <span>Legal / Privacy</span>
        </div>
        <h1
          class="text-text float-in m-0 text-[clamp(2.4rem,6vw,4.8rem)] leading-[1.02] font-medium tracking-[-0.03em]"
          style="animation-delay: 0.1s"
        >
          Privacy Policy.
        </h1>
        <p
          class="text-light-grey float-in mt-8 mb-0 text-[0.82rem] tracking-[0.08em] uppercase"
          style="animation-delay: 0.2s"
        >
          Last updated {lastUpdated}
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container">
        <div class="prose-site">
          <p>
            Jason Marshall Digital (“we”) is a web design and development
            business in {location}, USA. This policy explains what
            information we collect on <strong>jasonmarshall.digital</strong> and
            how we use it.
          </p>

          <h2>Information we collect</h2>
          <ul>
            <li>
              <strong>Contact form:</strong> your name, email, project type,
              budget and message. These are emailed to us so we can reply and
              are not stored in a website database.
            </li>
            <li>
              <strong>Analytics:</strong> Google Analytics uses cookies to
              record pages visited, referring site, device, browser and
              approximate location. Cloudflare Web Analytics collects similar
              data without cookies.
            </li>
            <li>
              <strong>Security:</strong> Cloudflare Turnstile checks browser and
              device signals to block spam on the contact form, and our hosting
              providers log technical data such as IP addresses to deliver and
              protect the site.
            </li>
            <li>
              <strong>Your theme choice</strong> (light or dark) is saved in
              your browser and never sent to us.
            </li>
          </ul>

          <h2>How we use it</h2>
          <p>
            To reply to enquiries and provide our services, to understand and
            improve how the site is used, and to keep it secure. We do not sell
            your personal information or use it for advertising.
          </p>

          <h2>Service providers</h2>
          <p>
            We use Netlify (hosting), Cloudflare (security, spam protection and
            analytics), Google Analytics, Resend (form email delivery) and
            Sanity (website content and images) to run this site. They process
            data only to provide these services.
          </p>

          <h2>Cookies</h2>
          <p>
            Google Analytics is the only service that sets cookies, and the site
            works without them. You can block cookies in your browser or use the{" "}
            <a
              href="https://tools.google.com/dlpage/gaoptout"
              target="_blank"
              rel="noopener noreferrer"
            >
              Google Analytics opt-out add-on
            </a>
            .
          </p>

          <h2>How long we keep it</h2>
          <p>
            Enquiries are kept for as long as needed to respond and for any work
            that follows, plus any period required for tax records. Analytics
            data is deleted automatically after 14 months.
          </p>

          <h2>Your rights</h2>
          <p>
            You can ask us to access, correct or delete your personal
            information by emailing <a href={`mailto:${email}`}>{email}</a>. We
            will respond within 30 days. If you are in the EEA or UK, you may
            also complain to your local data protection authority.
          </p>

          <h2>Other information</h2>
          <p>
            Our providers may process data in the United States and other
            countries. This site is not intended for children under 16. Links to
            client websites and GitHub are covered by those sites’ own policies.
          </p>

          <h2>Changes and contact</h2>
          <p>
            We may update this policy; the date above shows the latest version.
            Questions? Email <a href={`mailto:${email}`}>{email}</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
