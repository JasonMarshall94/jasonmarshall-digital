---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import ProjectsArchive from "@/components/ProjectsArchive.astro";
import Footer from "@/global/Footer.astro";
import { getSiteSettings } from "@/lib/sanity";

const settings = await getSiteSettings();
---

<BaseLayout
  title={`Projects — ${settings.title}`}
  description="Selected client work and personal builds from Jason Marshall Digital."
>
  <Nav page="page" />
  <main id="main-content">
    <ProjectsArchive />
  </main>
  <Footer />
</BaseLayout>
