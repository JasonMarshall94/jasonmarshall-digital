---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import Gallery from "@/components/Gallery.astro";
import RichText from "@/components/content/RichText.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSiteSettings, imageSrcset } from "@/lib/sanity";
import {
  breadcrumbNode,
  businessNode,
  caseStudyNode,
  graph,
} from "@/lib/structuredData";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const p = project.data;
const settings = await getSiteSettings();
const site = Astro.site!;
const path = `/projects/${p.slug}/`;
const year = p.postDate.getFullYear();

const cover = imageSrcset(p.cover, [640, 960, 1280, 1920], 16 / 9);

// Up to 3 other projects, newest first
const more = (await getCollection("projects"))
  .filter((other) => other.id !== project.id)
  .sort((a, b) => b.data.postDate.valueOf() - a.data.postDate.valueOf())
  .slice(0, 3);

const meta = [p.industry, p.location, String(year)].filter(Boolean).join(" · ");
const compare =
  p.comparison?.before && p.comparison?.after
    ? { ...p.comparison, before: p.comparison.before, after: p.comparison.after }
    : undefined;

const details = [
  p.industry && { label: "Industry", value: p.industry },
  p.location && { label: "Location", value: p.location },
  { label: "Launched", value: String(year) },
].filter((d): d is { label: string; value: string } => !!d);

const jsonLd = graph(
  businessNode(settings, site),
  breadcrumbNode(
    [
      ["Projects", "/projects/"],
      [p.title, path],
    ],
    site,
  ),
  caseStudyNode(
    {
      name: p.title,
      description: p.excerpt,
      path,
      image: cover.src,
      liveUrl: p.url,
    },
    site,
  ),
);
---

<BaseLayout
  title={p.seoTitle ?? `${p.title} — Website Case Study`}
  description={p.seoDescription ?? p.excerpt}
  jsonLd={jsonLd}
>
  <Nav page="page" />
  <main id="main-content">
    <section class="border-line relative overflow-hidden border-b">
      <div class="gridlines"></div>
      <div class="float-in relative container pt-12 pb-16">
        <nav aria-label="Breadcrumb">
          <ol class="label m-0 flex list-none flex-wrap items-center gap-2.5 p-0">
            <li><a href="/" class="text-faint hover:text-text">Home</a></li>
            <li class="flex items-center gap-2.5">
              <span class="text-line-strong" aria-hidden="true">/</span>
              <a href="/projects/" class="text-faint hover:text-text">Work</a>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-line-strong" aria-hidden="true">/</span>
              <span aria-current="page" class="text-muted">{p.title}</span>
            </li>
          </ol>
        </nav>
        <p class="label mt-9 mb-0 tracking-[0.14em]">{meta}</p>
        <h1 class="mt-4 mb-0 text-[clamp(40px,5vw,60px)] leading-none font-medium tracking-[-0.04em]">
          {p.title}
        </h1>
        <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
          <p class="text-body m-0 max-w-[560px] text-lg leading-[1.65]">{p.excerpt}</p>
          <div class="flex flex-wrap gap-3 max-[720px]:w-full max-[720px]:flex-nowrap max-[720px]:gap-2">
            {
              p.url && (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn max-[720px]:flex-1 max-[720px]:px-2 max-[720px]:text-[11px]"
                >
                  Visit live site <span aria-hidden="true">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )
            }
            <a href="/contact/" class="btn btn-primary max-[720px]:flex-1 max-[720px]:px-2 max-[720px]:text-[11px]">
              Start a project <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {
      compare ? (
        <BeforeAfter
          before={compare.before}
          after={compare.after}
          beforeLabel={compare.beforeLabel}
          afterLabel={compare.afterLabel}
          caption={compare.caption}
        />
      ) : (
        <div class="border-line border-b">
          <div class="container pt-12 pb-16 max-[720px]:pt-8 max-[720px]:pb-12">
            <div class="border-line bg-deep aspect-video overflow-hidden border">
              <img
                src={cover.src}
                srcset={cover.srcset}
                sizes="(max-width: 1200px) calc(100vw - 3rem), 1152px"
                width={cover.width}
                height={cover.height}
                alt={p.cover.alt}
                fetchpriority="high"
                decoding="async"
                class="block h-full w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      )
    }

    <section class="border-line border-b">
      <div class="container grid grid-cols-[minmax(0,1fr)] items-start gap-16 py-28 max-[720px]:gap-12 max-[720px]:py-16 min-[961px]:grid-cols-[minmax(0,1fr)_340px]">
        <RichText value={p.body} class="min-w-0" />

        <div role="group" aria-label="Project details" class="border-line bg-card border p-7 min-[961px]:sticky min-[961px]:top-20">
          <dl class="m-0 flex flex-col gap-5">
            {
              details.map((d) => (
                <div>
                  <dt class="label mb-1.5 text-[10px]">{d.label}</dt>
                  <dd class="m-0 text-base">{d.value}</dd>
                </div>
              ))
            }
            {
              p.services.length > 0 && (
                <div>
                  <dt class="label mb-2 text-[10px]">Services</dt>
                  <dd class="m-0 flex flex-wrap gap-2">
                    {p.services.map((s) => (
                      <a href={`/services/${s.slug}/`} class="tag border-control hover:border-text">
                        {s.title}
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
            {
              p.tags.length > 0 && (
                <div>
                  <dt class="label mb-1.5 text-[10px]">Built with</dt>
                  <dd class="text-body m-0 font-mono text-[13px]">{p.tags.join(" · ")}</dd>
                </div>
              )
            }
          </dl>
          {
            p.url && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn mt-7 w-full">
                Visit website <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    {p.gallery.length > 0 && <Gallery images={p.gallery} />}

    {
      more.length > 0 && (
        <section class="border-line border-b">
          <div class="container py-28 max-[720px]:py-16">
            <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
              <div>
                <div class="label">More work</div>
                <h2 class="mt-4 mb-0 text-[clamp(30px,3.6vw,46px)] leading-[1.08] font-medium tracking-[-0.03em]">
                  Other recent projects.
                </h2>
              </div>
              <a href="/projects/" class="text-body border-line-strong hover:text-text border-b pb-1 font-mono text-[13px]">
                All projects →
              </a>
            </div>
            <div class="swipe-sm grid gap-6 md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
              {more.map((m) => <ProjectCard project={m} />)}
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>
