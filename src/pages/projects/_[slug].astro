---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Footer from "@/global/Footer.astro";
import { getSiteSettings } from "@/lib/sanity";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

if (!project) {
  return new Response(null, { status: 404 });
}

const settings = await getSiteSettings();
const { title, excerpt } = project.data;
const pageTitle = `${title} | ${settings.title}`;
---

<BaseLayout
  title={pageTitle}
  description="Selected client work and personal builds from Jason Marshall Digital."
>
  <Nav />
  <main>
    <p>{excerpt}</p>
  </main>
  <Footer />
</BaseLayout>
