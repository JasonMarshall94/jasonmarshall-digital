---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/global/Nav.astro";
import Hero from "@/components/Hero.astro";
import ServicesTicker from "@/components/ServicesTicker.astro";
import RecentWork from "@/components/RecentWork.astro";
import Services from "@/components/Services.astro";
import Footer from "@/global/Footer.astro";
import { getSiteSettings } from "@/lib/sanity";
import { homepageJsonLd } from "@/lib/structuredData";

const settings = await getSiteSettings();
---

<BaseLayout
  title={settings.homeTitle ?? settings.title}
  jsonLd={homepageJsonLd(settings, Astro.site!)}
>
  <Nav />
  <main id="main-content">
    <Hero />
    <ServicesTicker />
    <RecentWork />
    <Services />
  </main>
  <Footer />
</BaseLayout>
