---
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// Both icons sit in the same spot; the hidden one is rotated and faded out
const icon =
  "absolute transition-[rotate,scale,opacity] duration-500 ease-(--ease-expo) motion-reduce:transition-none";
---

<!-- A bare icon (no box), muted until hover; 44px hit area -->
<button
  type="button"
  data-theme-toggle
  class={`text-muted hover:text-text relative inline-flex h-11 w-11 cursor-pointer items-center justify-center border-0 bg-transparent transition-colors duration-200 ${className}`}
>
  <span class="sr-only" data-theme-label>Switch to light theme</span>
  <!-- Sun shows in dark mode (switch to light); moon shows in light mode -->
  <Icon
    name="sun"
    width={16}
    height={16}
    aria-hidden="true"
    class={`${icon} light:-rotate-90 light:scale-50 light:opacity-0`}
  />
  <Icon
    name="moon"
    width={16}
    height={16}
    aria-hidden="true"
    class={`${icon} rotate-90 scale-50 opacity-0 light:rotate-0 light:scale-100 light:opacity-100`}
  />
</button>

<script>
  import "@/scripts/theme";
</script>
