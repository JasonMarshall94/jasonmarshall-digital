---
import Logo from "@/global/Logo.astro";
import ThemeToggle from "@/ui/ThemeToggle.astro";
import navLinksData from "@/data/navLinks.json";

interface Props {
  // "home" => links use hash anchors (#work, #services, etc.)
  // "page" => links route back to "/#section", Work links to /projects
  page?: "home" | "page";
}
const { page = "home" } = Astro.props;

const isHome = page === "home";
const homeHref = "/";

type NavLink = { title: string; slug: string; pageHref?: string; href?: string };

const currentPath = Astro.url.pathname;

// `href` = a real page (same on every page); otherwise a homepage section,
// with `pageHref` overriding the link used on other pages.
const links = (navLinksData as NavLink[]).map(({ title, slug, pageHref, href }) => ({
  title,
  slug,
  href: href ?? (isHome ? `#${slug}` : (pageHref ?? `${homeHref}#${slug}`)),
  active: href
    ? currentPath.startsWith(href)
    : !isHome && !!pageHref && currentPath.startsWith(pageHref),
}));
// Contact is the header button, so it stays out of the desktop link row
const rowLinks = links.filter((l) => l.slug !== "contact");
---

<header
  id="site-nav"
  data-open="false"
  class="group/nav border-line bg-bg relative z-50 border-b"
>
  <div class="container flex h-18 items-center justify-between gap-6">
    <a
      href={isHome ? "#top" : homeHref}
      class="text-text flex items-center gap-3"
      aria-label="Jason Marshall Digital home"
    >
      <Logo size={30} />
      <span
        class="hide-mobile text-muted font-mono text-xs tracking-[0.14em] uppercase"
        >Jason Marshall Digital</span
      >
    </a>

    <nav aria-label="Main" class="flex items-center gap-7">
      {
        rowLinks.map((l) => (
          <a
            href={l.href}
            data-section={l.slug}
            aria-current={l.active ? "page" : undefined}
            class={`nav-link nav-anchor hide-mobile font-mono text-[13px] transition-colors duration-200 ${
              l.active ? "text-text active" : "text-muted hover:text-text"
            }`}
          >
            {l.title}
          </a>
        ))
      }

      <ThemeToggle />

      <a href="/contact/" class="btn btn-primary btn-sm hide-mobile">
        Start a project <span aria-hidden="true">→</span>
      </a>

      <!-- Hamburger -->
      <button
        id="nav-hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="hide-desktop border-control text-text relative flex h-11 w-11 cursor-pointer flex-col items-center justify-center gap-1.25 border bg-transparent"
      >
        <span
          class="block h-px w-4.5 origin-center bg-current transition-all duration-300 group-data-[open=true]/nav:translate-y-1.5 group-data-[open=true]/nav:rotate-45"
        ></span>
        <span
          class="block h-px w-4.5 bg-current transition-all duration-300 group-data-[open=true]/nav:opacity-0"
        ></span>
        <span
          class="block h-px w-4.5 origin-center bg-current transition-all duration-300 group-data-[open=true]/nav:-translate-y-1.5 group-data-[open=true]/nav:-rotate-45"
        ></span>
      </button>
    </nav>
  </div>
</header>

<!-- Backdrop -->
<div
  id="nav-backdrop"
  aria-hidden="true"
  class="bg-bg/70 pointer-events-none fixed inset-0 z-40 opacity-0 backdrop-blur-sm transition-opacity duration-300"
>
</div>

<!-- Off-canvas drawer -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
  class="border-line bg-card fixed top-0 right-0 bottom-0 z-50 flex w-[min(320px,85vw)] translate-x-full flex-col border-l transition-transform duration-350 ease-(--ease-expo)"
>
  <!-- Drawer header -->
  <div
    class="border-line flex h-18 shrink-0 items-center justify-between border-b px-6"
  >
    <span class="label">Menu</span>
    <button
      id="nav-close"
      type="button"
      aria-label="Close menu"
      class="border-control text-text inline-flex h-11 w-11 cursor-pointer items-center justify-center border bg-transparent"
    >
      <span aria-hidden="true" class="text-[1.1rem] leading-none">×</span>
    </button>
  </div>

  <!-- Links -->
  <nav aria-label="Mobile" class="flex flex-1 flex-col px-6 py-6">
    {
      links.map((l) => (
        <a
          href={l.href}
          data-section={l.slug}
          aria-current={l.active ? "page" : undefined}
          class={`mobile-nav-link border-line border-b py-5 text-2xl font-medium tracking-[-0.02em] transition-colors duration-200 ${
            l.active ? "text-text" : "text-muted hover:text-text"
          }`}
        >
          {l.title}
        </a>
      ))
    }
  </nav>

  <!-- Drawer footer -->
  <div class="border-line shrink-0 border-t px-6 py-6">
    <a href="/contact/" class="btn btn-primary w-full">
      Start a project <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  const nav = document.getElementById("site-nav");
  const hamburger = document.getElementById(
    "nav-hamburger",
  ) as HTMLButtonElement | null;
  const closeBtn = document.getElementById("nav-close");
  const backdrop = document.getElementById("nav-backdrop");
  const drawer = document.getElementById("mobile-menu");

  // ── Mobile menu ──────────────────────────────────────────────

  const openMenu = () => {
    nav?.setAttribute("data-open", "true");
    hamburger?.setAttribute("aria-expanded", "true");
    hamburger?.setAttribute("aria-label", "Close menu");
    backdrop?.classList.remove("opacity-0", "pointer-events-none");
    backdrop?.classList.add("opacity-100", "pointer-events-auto");
    drawer?.classList.remove("translate-x-full");
    drawer?.classList.add("translate-x-0");
    document.body.classList.add("overflow-hidden");
    document.querySelector("main")?.setAttribute("inert", "");
    drawer?.querySelector<HTMLAnchorElement>("a")?.focus();
  };

  const closeMenu = () => {
    nav?.setAttribute("data-open", "false");
    hamburger?.setAttribute("aria-expanded", "false");
    hamburger?.setAttribute("aria-label", "Open menu");
    backdrop?.classList.add("opacity-0", "pointer-events-none");
    backdrop?.classList.remove("opacity-100", "pointer-events-auto");
    drawer?.classList.add("translate-x-full");
    drawer?.classList.remove("translate-x-0");
    document.body.classList.remove("overflow-hidden");
    document.querySelector("main")?.removeAttribute("inert");
    hamburger?.focus();
  };

  hamburger?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.dataset.open === "true") closeMenu();
  });

  drawer?.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // ── Active homepage section ──────────────────────────────────

  const sectionIds = ["top", "work", "services", "about", "contact"];
  const anchors = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".nav-anchor"),
  );
  const hasSections = sectionIds.some((id) => document.getElementById(id));

  const setActive = (a: HTMLAnchorElement, active: boolean) => {
    a.classList.toggle("active", active);
    a.classList.toggle("text-text", active);
    a.classList.toggle("text-muted", !active);
  };

  const onScroll = () => {
    const y = window.scrollY + window.innerHeight / 3;
    let current = "top";
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) current = id;
    }
    anchors.forEach((a) => {
      // Links to other pages keep their server-rendered active state
      if (a.getAttribute("href")?.startsWith("/")) return;
      setActive(a, a.dataset.section === current);
    });
  };

  if (hasSections) {
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
