---
// Homepage services: four short cards. Development groups the WordPress and
// custom services, so it links to the overview.
const cards = [
  {
    title: "Web design",
    text: "Custom, mobile-first layouts built around how your customers choose you.",
    href: "/services/web-design/",
    icon: "design",
  },
  {
    title: "Development",
    text: "WordPress you can edit yourself, or a custom build when speed matters most.",
    href: "/services/",
    icon: "code",
  },
  {
    title: "SEO",
    text: "Technical and local SEO so customers find you when they search.",
    href: "/services/seo/",
    icon: "seo",
  },
  {
    title: "Maintenance",
    text: "Updates, backups and fixes from the developer who knows your site.",
    href: "/services/website-maintenance/",
    icon: "care",
  },
];
---

<section id="services" class="border-line scroll-mt-4 border-b">
  <div class="container py-28 max-[720px]:py-16">
    <div class="label">Services</div>
    <h2
      class="mt-4 mb-12 max-w-[720px] text-[clamp(32px,4vw,52px)] leading-[1.05] font-medium tracking-[-0.03em]"
    >
      Everything your website needs, from one developer.
    </h2>
    <div
      class="bg-line border-line grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-px border"
    >
      {
        cards.map((c) => (
          <a
            href={c.href}
            class="group bg-card text-text grid grid-cols-[auto_minmax(0,1fr)] content-start items-center gap-x-3.5 gap-y-3.5 p-8 max-[720px]:gap-y-2.5 max-[720px]:p-6 min-[721px]:flex min-[721px]:flex-col min-[721px]:items-start"
          >
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke-width="1.5"
              aria-hidden="true"
              class="stroke-signal h-12 w-12 max-[720px]:h-8 max-[720px]:w-8"
            >
              {c.icon === "design" && (
                <>
                  <rect x="4" y="8" width="40" height="32" />
                  <path class="draw" d="M4 16 H44 M12 24 H28 M12 30 H22" />
                  <path d="M34 26 l8 8 -4 1 2 5 -2 1 -2 -5 -3 3 z" class="fill-signal" stroke="none" />
                </>
              )}
              {c.icon === "code" && (
                <>
                  <path d="M16 12 L6 24 L16 36 M32 12 L42 24 L32 36" />
                  <path class="flow" d="M27 10 L21 38" />
                </>
              )}
              {c.icon === "seo" && (
                <>
                  <path d="M6 42 H42" />
                  <rect class="bar fill-signal" x="10" y="28" width="6" height="14" stroke="none" />
                  <rect class="bar fill-signal" x="21" y="20" width="6" height="22" stroke="none" style="animation-delay: 0.2s" />
                  <rect class="bar fill-signal" x="32" y="10" width="6" height="32" stroke="none" style="animation-delay: 0.4s" />
                </>
              )}
              {c.icon === "care" && (
                <>
                  <path d="M24 4 L40 10 V22 C40 32 33 39 24 44 C15 39 8 32 8 22 V10 Z" />
                  <path class="draw" d="M16 24 L22 30 L33 18" />
                </>
              )}
            </svg>
            <h3 class="m-0 text-[22px] font-medium max-[720px]:text-xl">{c.title}</h3>
            <p class="text-body col-span-2 m-0 text-[15px] leading-[1.65]">{c.text}</p>
            <span class="text-muted group-hover:text-text col-span-2 mt-auto font-mono text-xs whitespace-nowrap">
              Learn more →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
