---
import type { CollectionEntry } from "astro:content";
import { imageSrcset } from "@/lib/sanity";

interface Props {
  project: CollectionEntry<"projects">;
  description?: string;
  loading?: "lazy" | "eager";
  /** Small "Latest" badge on the image (homepage, phones) */
  latest?: boolean;
  class?: string;
}
const {
  project,
  description,
  loading = "lazy",
  latest = false,
  class: className = "",
} = Astro.props;
const { data } = project;

const cover = imageSrcset(data.cover, [400, 600, 800, 1200], 16 / 9);
const meta = [data.industry, data.location].filter(Boolean).join(" · ");
const year = data.postDate.getFullYear();
---

<!-- One link per card: everything inside is plain text, never a nested link -->
<a
  href={`/projects/${data.slug}/`}
  class={`lift border-line bg-card text-text relative flex flex-col overflow-hidden border ${className}`}
>
  <div class="bg-deep aspect-video overflow-hidden">
    <img
      src={cover.src}
      srcset={cover.srcset}
      sizes="(max-width: 720px) 84vw, (max-width: 1100px) calc(50vw - 3rem), 576px"
      width={cover.width}
      height={cover.height}
      alt={data.cover.alt}
      loading={loading}
      decoding="async"
      class="block h-full w-full object-cover object-top"
    />
  </div>
  {
    latest && (
      <span class="bg-signal text-on-signal absolute top-3 right-3 px-2 py-1 font-mono text-[10px] font-medium tracking-[0.14em] uppercase">
        Latest
      </span>
    )
  }
  <div class="flex flex-1 flex-col p-7">
    <div class="label flex justify-between gap-3 tracking-[0.14em]">
      <span class="truncate">{meta}</span>
      <span class="shrink-0">{year}</span>
    </div>
    <h3 class="mt-2.5 mb-2 text-2xl font-medium tracking-[-0.01em]">{data.title}</h3>
    <p class="text-body mt-0 mb-5 text-[15px] leading-[1.65]">
      {description ?? data.excerpt}
    </p>
    <div
      class="border-line text-muted mt-auto flex justify-between gap-4 border-t pt-4.5 font-mono text-xs"
    >
      <span class="truncate max-[720px]:hidden">{data.tags.join(" / ")}</span>
      <span class="text-signal-ink shrink-0 whitespace-nowrap">Case study <span data-cue>→</span></span>
    </div>
  </div>
</a>
