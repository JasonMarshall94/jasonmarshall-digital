---
// Small 300×120 explanatory diagrams for the services pages. They illustrate
// an idea; they never show real results or numbers.
export type DiagramName =
  | "browser"
  | "editor"
  | "pipeline"
  | "search"
  | "checklist"
  | "bubbles"
  | "journey"
  | "custom"
  | "plugins"
  | "migrate"
  | "choice"
  | "structure"
  | "local"
  | "report"
  | "support"
  | "takeover";

interface Props {
  name: DiagramName;
  /** Search phrase for the "search" diagram */
  query?: string;
  /** Result title for the "search" diagram */
  result?: string;
}
const {
  name,
  query = "plumber near me",
  result = "Your Business — Plumbing",
} = Astro.props;

const labels: Record<DiagramName, string> = {
  browser: "A browser window with a custom page layout being designed",
  editor: "A website dashboard with a page being edited and a publish button",
  pipeline: "Content flows from the content dashboard through a build step to a global network, then to visitors",
  search: "A search results page with your business as the top result",
  checklist: "A checklist with backups, updates and a security scan done, and a content edit on request",
  bubbles: "Two speech bubbles: a question and a reply",
  journey: "Search leads to your site, which leads to a call or contact",
  custom: "Three identical template layouts beside one distinct custom layout",
  plugins: "A typical site stacked with many plugins beside a lean site with only a few",
  migrate: "An existing website being rebuilt into a new one, keeping its content",
  choice: "Your goals lead to either WordPress or a custom build",
  structure: "A homepage linked to service pages, each with a title, description and structured data",
  local: "A map of a service area with your business pinned in the middle",
  report: "A simple report chart of search visits over time",
  support: "An email asking for a change and a quick reply saying it's done",
  takeover: "An existing site goes through a review, then into regular care",
};
---

<svg viewBox="0 0 300 120" width="100%" role="img" aria-label={labels[name]} class="block h-auto">
  {
    name === "browser" && (
      <>
        <rect x="4" y="4" width="292" height="112" class="fill-card stroke-line-strong" />
        <path d="M4 18 H296" class="stroke-line-strong" />
        <g class="fill-line-strong">
          <circle cx="13" cy="11" r="2.5" />
          <circle cx="22" cy="11" r="2.5" />
          <circle cx="31" cy="11" r="2.5" />
        </g>
        <path class="draw stroke-signal" d="M18 36 H150 M18 48 H112" stroke-width="5" />
        <rect x="18" y="62" width="58" height="14" class="fill-signal" opacity="0.85" />
        <rect x="170" y="30" width="112" height="72" fill="none" class="stroke-signal" stroke-dasharray="4 3" />
        <g class="fill-line">
          <rect x="18" y="88" width="40" height="18" />
          <rect x="64" y="88" width="40" height="18" />
          <rect x="110" y="88" width="40" height="18" />
        </g>
        <path d="M250 78 l12 12 -6 1.5 3 7 -3 1.5 -3 -7 -4.5 4.5 z" class="fill-signal" />
      </>
    )
  }
  {
    name === "editor" && (
      <>
        <rect x="4" y="4" width="292" height="112" class="fill-card stroke-line-strong" />
        <rect x="4" y="4" width="64" height="112" class="fill-line" />
        <g class="fill-line-strong">
          <rect x="14" y="18" width="40" height="5" />
          <rect x="14" y="32" width="32" height="5" />
          <rect x="14" y="46" width="36" height="5" />
          <rect x="14" y="60" width="28" height="5" />
        </g>
        <text x="82" y="26" font-size="9" letter-spacing="1" class="fill-muted font-mono">EDIT PAGE</text>
        <rect x="82" y="36" width="140" height="18" fill="none" class="stroke-signal" />
        <text x="90" y="49" font-size="10" class="fill-text font-sans">
          Our services<tspan class="blink fill-signal">|</tspan>
        </text>
        <rect x="82" y="62" width="140" height="40" fill="none" class="stroke-line-strong" />
        <g class="fill-line-strong">
          <rect x="90" y="70" width="110" height="4" />
          <rect x="90" y="80" width="90" height="4" />
          <rect x="90" y="90" width="100" height="4" />
        </g>
        <rect x="234" y="36" width="52" height="18" class="fill-signal" />
        <text x="260" y="48" text-anchor="middle" font-size="8" letter-spacing="1" class="fill-on-signal font-mono">
          PUBLISH
        </text>
      </>
    )
  }
  {
    name === "pipeline" && (
      <>
        <g class="fill-card stroke-line-strong">
          <rect x="6" y="38" width="76" height="44" />
          <rect x="218" y="38" width="76" height="44" />
        </g>
        <rect x="112" y="30" width="76" height="60" class="fill-card stroke-signal" />
        <g font-size="9" text-anchor="middle" letter-spacing="1" class="font-mono">
          <text x="44" y="64" class="fill-muted">CMS</text>
          <text x="150" y="58" class="fill-text">BUILD</text>
          <text x="150" y="72" font-size="7" class="fill-faint">FRAMEWORK</text>
          <text x="256" y="64" class="fill-signal">CDN</text>
        </g>
        <g fill="none" stroke-width="1.5" class="stroke-signal">
          <line class="flow" x1="84" y1="60" x2="108" y2="60" />
          <line class="flow" x1="190" y1="60" x2="214" y2="60" />
          <path d="M104 56 L110 60 L104 64 M210 56 L216 60 L210 64" />
        </g>
        <g class="fill-line-strong">
          <circle cx="232" cy="102" r="3" />
          <circle cx="256" cy="106" r="3" />
          <circle cx="280" cy="102" r="3" />
        </g>
        <path d="M256 84 V100 M244 84 L232 98 M268 84 L280 98" class="stroke-line-strong" />
      </>
    )
  }
  {
    name === "search" && (
      <>
        <rect x="4" y="6" width="292" height="24" class="fill-card stroke-line-strong" />
        <text x="14" y="22" font-size="9" class="fill-muted font-mono">{query}</text>
        <circle cx="280" cy="18" r="5" fill="none" class="stroke-muted" />
        <text x="8" y="50" font-size="8" class="fill-faint font-mono">yourbusiness.com</text>
        <text x="8" y="64" font-size="12" class="fill-signal font-sans">{result}</text>
        <rect x="8" y="72" width="230" height="4" class="fill-line-strong" />
        <rect x="8" y="80" width="180" height="4" class="fill-line-strong" />
        <g opacity="0.5">
          <rect x="8" y="96" width="120" height="5" class="fill-line" />
          <rect x="8" y="106" width="200" height="4" class="fill-line" />
        </g>
        <rect x="0" y="40" width="3" height="44" class="fill-signal" />
      </>
    )
  }
  {
    name === "checklist" && (
      <>
        {["BACKUP", "UPDATES", "SECURITY SCAN"].map((t, i) => (
          <g transform={`translate(0 ${8 + i * 28})`}>
            <rect x="4" y="0" width="292" height="22" class="fill-card stroke-line" />
            <path d="M14 11 L18 15 L25 7" fill="none" stroke-width="1.8" class="stroke-signal" />
            <text x="36" y="15" font-size="9" letter-spacing="1" class="fill-muted font-mono">{t}</text>
            <text x="286" y="15" text-anchor="end" font-size="8" class="fill-faint font-mono">DONE</text>
          </g>
        ))}
        <g transform="translate(0 92)">
          <rect x="4" y="0" width="292" height="22" fill="none" stroke-dasharray="4 3" class="stroke-signal" />
          <circle cx="19" cy="11" r="5" fill="none" class="stroke-signal blink" />
          <text x="36" y="15" font-size="9" letter-spacing="1" class="fill-signal font-mono">CONTENT EDIT</text>
          <text x="286" y="15" text-anchor="end" font-size="8" class="fill-faint font-mono">ON REQUEST</text>
        </g>
      </>
    )
  }
  {
    name === "bubbles" && (
      <>
        <path d="M8 10 H170 V52 H40 L26 64 V52 H8 Z" class="fill-card stroke-line-strong" />
        <text x="20" y="35" font-size="11" class="fill-body font-sans">Where do I start?</text>
        <path d="M120 62 H292 V104 H274 V116 L260 104 H120 Z" fill="none" class="stroke-signal" />
        <text x="134" y="87" font-size="11" class="fill-signal font-sans">Let's talk it through.</text>
      </>
    )
  }
  {
    name === "journey" && (
      <>
        <g class="fill-card stroke-line-strong">
          <rect x="6" y="38" width="76" height="44" />
          <rect x="112" y="30" width="76" height="60" />
        </g>
        <rect x="218" y="38" width="76" height="44" fill="none" class="stroke-signal" />
        <g font-size="9" text-anchor="middle" letter-spacing="1" class="font-mono">
          <text x="44" y="64" class="fill-muted">SEARCH</text>
          <text x="150" y="64" class="fill-text">YOUR SITE</text>
          <text x="256" y="64" class="fill-signal">CONTACT</text>
        </g>
        <g fill="none" stroke-width="1.5" class="stroke-signal">
          <line class="flow" x1="84" y1="60" x2="108" y2="60" />
          <line class="flow" x1="190" y1="60" x2="214" y2="60" />
          <path d="M104 56 L110 60 L104 64 M210 56 L216 60 L210 64" />
        </g>
      </>
    )
  }
  {
    name === "custom" && (
      <>
        {[4, 76, 148].map((x) => (
          <g>
            <rect x={x} y="10" width="64" height="84" fill="none" class="stroke-line-strong" />
            <path d={`M${x + 8} 22 H${x + 56} M${x + 8} 32 H${x + 40}`} stroke-width="3" class="stroke-line-strong" />
            <rect x={x + 8} y="44" width="48" height="16" class="fill-line" />
            <rect x={x + 8} y="66" width="48" height="16" class="fill-line" />
          </g>
        ))}
        <rect x="228" y="10" width="64" height="84" fill="none" class="stroke-signal" />
        <path d="M236 20 H284 M236 30 H268" stroke-width="3" class="stroke-signal" />
        <rect x="236" y="40" width="28" height="44" fill="none" class="stroke-signal" />
        <rect x="270" y="40" width="16" height="20" opacity="0.35" class="fill-signal" />
        <g font-size="8" letter-spacing="1" class="font-mono">
          <text x="4" y="112" class="fill-faint">TEMPLATES</text>
          <text x="228" y="112" class="fill-signal">CUSTOM</text>
        </g>
      </>
    )
  }
  {
    name === "plugins" && (
      <>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect x={14 + (i % 4) * 30} y={22 + Math.floor(i / 4) * 30} width="24" height="24" class="fill-line stroke-line-strong" />
        ))}
        <rect x="14" y="82" width="114" height="10" class="fill-line-strong" />
        <path d="M150 20 V100" class="stroke-line" />
        {[0, 1, 2].map((i) => (
          <rect x={180 + i * 34} y="52" width="26" height="26" fill="none" stroke-width="1.5" class="stroke-signal" />
        ))}
        <rect x="180" y="82" width="94" height="10" class="fill-signal" opacity="0.85" />
        <g font-size="8" letter-spacing="1" class="font-mono">
          <text x="14" y="112" class="fill-faint">TYPICAL</text>
          <text x="180" y="112" class="fill-signal">LEAN</text>
        </g>
      </>
    )
  }
  {
    name === "migrate" && (
      <>
        <rect x="6" y="20" width="100" height="74" class="fill-card stroke-line-strong" />
        <g class="fill-line">
          <rect x="14" y="30" width="84" height="8" />
          <rect x="14" y="44" width="60" height="5" />
          <rect x="14" y="54" width="70" height="5" />
          <rect x="14" y="68" width="38" height="18" />
          <rect x="58" y="68" width="38" height="18" />
        </g>
        <g fill="none" stroke-width="1.5" class="stroke-signal">
          <line class="flow" x1="114" y1="57" x2="182" y2="57" />
          <path d="M178 53 L184 57 L178 61" />
        </g>
        <rect x="194" y="20" width="100" height="74" fill="none" stroke-width="1.5" class="stroke-signal" />
        <path class="draw stroke-text" d="M202 32 H286" stroke-width="5" />
        <g class="fill-line-strong">
          <rect x="202" y="44" width="60" height="5" />
          <rect x="202" y="54" width="70" height="5" />
        </g>
        <rect x="202" y="68" width="40" height="18" class="fill-signal" opacity="0.85" />
        <g font-size="8" letter-spacing="1" class="font-mono">
          <text x="6" y="112" class="fill-faint">YOUR SITE TODAY</text>
          <text x="194" y="112" class="fill-signal">REBUILT</text>
        </g>
      </>
    )
  }
  {
    name === "choice" && (
      <>
        <rect x="6" y="42" width="84" height="36" class="fill-card stroke-line-strong" />
        <text x="48" y="64" text-anchor="middle" font-size="9" letter-spacing="1" class="fill-text font-mono">YOUR GOALS</text>
        <g fill="none" stroke-width="1.5">
          <path d="M90 60 H130 V30 H180" class="stroke-line-strong" />
          <path class="flow stroke-signal" d="M90 60 H130 V90 H180" />
        </g>
        <rect x="180" y="12" width="114" height="36" fill="none" class="stroke-line-strong" />
        <rect x="180" y="72" width="114" height="36" fill="none" class="stroke-signal" />
        <g font-size="9" text-anchor="middle" letter-spacing="1" class="font-mono">
          <text x="237" y="34" class="fill-muted">WORDPRESS</text>
          <text x="237" y="94" class="fill-signal">CUSTOM</text>
        </g>
      </>
    )
  }
  {
    name === "structure" && (
      <>
        <rect x="112" y="6" width="76" height="26" class="fill-card stroke-line-strong" />
        <text x="150" y="23" text-anchor="middle" font-size="8" letter-spacing="1" class="fill-text font-mono">HOME</text>
        <path d="M150 32 V44 M48 44 H252 M48 44 V56 M150 44 V56 M252 44 V56" fill="none" class="stroke-line-strong" />
        {[10, 112, 214].map((x, i) => (
          <g>
            <rect x={x} y="56" width="76" height="58" class={i === 1 ? "fill-card stroke-signal" : "fill-card stroke-line-strong"} />
            <text x={x + 8} y="72" font-size="7" class="fill-faint font-mono">&lt;title&gt;</text>
            <rect x={x + 8} y="78" width="58" height="4" class={i === 1 ? "fill-signal" : "fill-line-strong"} />
            <rect x={x + 8} y="88" width="46" height="4" class="fill-line" />
            <text x={x + 8} y="106" font-size="7" class="fill-faint font-mono">schema</text>
          </g>
        ))}
      </>
    )
  }
  {
    name === "local" && (
      <>
        <rect x="4" y="4" width="292" height="112" class="fill-card stroke-line-strong" />
        <path d="M4 40 H296 M4 84 H296 M80 4 V116 M200 4 V116 M4 112 L120 4 M180 116 L296 20" fill="none" class="stroke-line" />
        <circle cx="150" cy="60" r="42" fill="none" stroke-dasharray="4 4" class="stroke-signal" />
        <path d="M150 74 C142 62 138 56 138 50 A12 12 0 0 1 162 50 C162 56 158 62 150 74 Z" class="fill-signal" />
        <circle cx="150" cy="50" r="4" class="fill-card" />
        <text x="10" y="110" font-size="8" letter-spacing="1" class="fill-faint font-mono">SERVICE AREA</text>
      </>
    )
  }
  {
    name === "report" && (
      <>
        <path d="M24 10 V100 H292" fill="none" class="stroke-line-strong" />
        {[30, 50, 70].map((y) => <path d={`M24 ${y} H292`} class="stroke-line" />)}
        <path class="draw stroke-signal" d="M28 92 L70 86 L110 88 L150 72 L190 66 L230 48 L270 36 L290 30" fill="none" stroke-width="2" />
        <text x="30" y="114" font-size="8" letter-spacing="1" class="fill-faint font-mono">SEARCH VISITS · ILLUSTRATION</text>
      </>
    )
  }
  {
    name === "support" && (
      <>
        <rect x="6" y="8" width="180" height="46" class="fill-card stroke-line-strong" />
        <text x="16" y="26" font-size="7" letter-spacing="1" class="fill-faint font-mono">FROM: YOU</text>
        <text x="16" y="43" font-size="11" class="fill-body font-sans">Can you update our hours?</text>
        <rect x="114" y="66" width="180" height="46" fill="none" class="stroke-signal" />
        <text x="124" y="84" font-size="7" letter-spacing="1" class="fill-faint font-mono">FROM: JASON</text>
        <text x="124" y="101" font-size="11" class="fill-signal font-sans">Done. They're live now.</text>
      </>
    )
  }
  {
    name === "takeover" && (
      <>
        <rect x="6" y="38" width="80" height="44" class="fill-card stroke-line-strong" />
        <rect x="110" y="30" width="80" height="60" class="fill-card stroke-line-strong" />
        <rect x="214" y="38" width="80" height="44" fill="none" class="stroke-signal" />
        <g font-size="8" text-anchor="middle" letter-spacing="1" class="font-mono">
          <text x="46" y="63" class="fill-muted">YOUR SITE</text>
          <text x="150" y="50" class="fill-text">REVIEW</text>
          <text x="254" y="63" class="fill-signal">CARE PLAN</text>
        </g>
        <g fill="none" stroke-width="1.5" class="stroke-signal">
          <path d="M128 62 L132 66 L139 58 M128 76 L132 80 L139 72" />
          <line class="flow" x1="88" y1="60" x2="106" y2="60" />
          <line class="flow" x1="192" y1="60" x2="210" y2="60" />
        </g>
        <g class="fill-line-strong">
          <rect x="146" y="61" width="34" height="4" />
          <rect x="146" y="75" width="28" height="4" />
        </g>
      </>
    )
  }
</svg>
