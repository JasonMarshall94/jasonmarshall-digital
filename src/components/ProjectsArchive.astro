---
import { getCollection } from "astro:content";
import PageHero from "@/components/content/PageHero.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.postDate.valueOf() - a.data.postDate.valueOf(),
);
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const unique = (values: (string | null | undefined)[]) =>
  [...new Set(values.filter((v): v is string => !!v))];

// Filter groups. Options come from the content, so a new industry or tech tag
// shows up as soon as a project uses it.
const groups = [
  {
    key: "industry",
    label: "Industry",
    options: unique(projects.map((p) => p.data.industry))
      .sort()
      .map((v) => ({ value: v, label: v })),
  },
  {
    key: "service",
    label: "Service",
    options: services.map((s) => ({ value: s.data.slug, label: s.data.title })),
  },
  {
    key: "tech",
    label: "Tech",
    options: unique(projects.flatMap((p) => p.data.tags)).map((v) => ({ value: v, label: v })),
  },
];
const sorts = [
  { value: "newest", label: "Newest" },
  { value: "oldest", label: "Oldest" },
  { value: "az", label: "Name A–Z" },
  { value: "za", label: "Name Z–A" },
];

const menuClass =
  "border-line-strong bg-card absolute top-[calc(100%+6px)] z-40 min-w-60 border p-1.5 shadow-[0_16px_32px_-16px_rgba(0,0,0,0.5)]";
const optionClass =
  "text-text aria-pressed:bg-text aria-pressed:text-bg flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent px-3 py-2.5 text-left font-mono text-xs hover:bg-[color-mix(in_oklab,var(--color-text)_6%,transparent)] disabled:cursor-default disabled:opacity-40";
const triggerClass =
  "border-control text-text inline-flex h-10 cursor-pointer items-center gap-2.5 border bg-transparent px-3.5 font-mono text-xs tracking-[0.04em] whitespace-nowrap hover:border-text";
---

<PageHero
  heading="Recent work"
  subline="Websites for small businesses, studios and local brands"
  intro="A few sites I've built lately, each one shaped around how that business wins its customers."
  breadcrumbs={[{ label: "Recent work" }]}
/>

<div id="project-filters" class="border-line bg-bg sticky top-0 z-30 border-b">
  <!-- Desktop: one slim bar of dropdowns -->
  <div class="hide-mobile container flex items-center justify-between gap-3 py-3">
    <div class="flex items-center gap-2">
      {
        groups.map((g) => (
          <div class="relative" data-dropdown={g.key}>
            <button
              type="button"
              class={triggerClass}
              aria-expanded="false"
              aria-controls={`menu-${g.key}`}
              data-trigger
            >
              <span data-trigger-label>{g.label}: All</span>
              <span aria-hidden="true">▾</span>
            </button>
            <div id={`menu-${g.key}`} role="group" aria-label={`Filter by ${g.label.toLowerCase()}`} class={`${menuClass} left-0`} hidden data-menu>
              {[{ value: "", label: "All" }, ...g.options].map((o) => (
                <button type="button" class={optionClass} data-filter={g.key} data-value={o.value} aria-pressed="false">
                  {o.label}
                  <span class="opacity-60" data-count />
                </button>
              ))}
            </div>
          </div>
        ))
      }
      <button
        type="button"
        data-clear
        hidden
        class="text-muted hover:text-text h-10 cursor-pointer border-0 bg-transparent px-2.5 font-mono text-[11px] tracking-[0.08em] uppercase underline underline-offset-3"
      >
        Clear
      </button>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-muted font-mono text-xs whitespace-nowrap" aria-live="polite" data-shown></span>
      <div class="relative" data-dropdown="sort">
        <button type="button" class={triggerClass} aria-expanded="false" aria-controls="menu-sort" data-trigger>
          <span data-trigger-label>Sort: Newest</span>
          <span aria-hidden="true">▾</span>
        </button>
        <div id="menu-sort" role="group" aria-label="Sort projects" class={`${menuClass} right-0`} hidden data-menu>
          {
            sorts.map((o) => (
              <button type="button" class={optionClass} data-sort={o.value} aria-pressed="false">
                {o.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Phones: a Filters button that opens a panel, plus Sort -->
  <div class="hide-desktop relative">
    <div class="container flex items-center justify-between gap-2.5 py-2.5">
      <button type="button" class={triggerClass} aria-expanded="false" aria-controls="filter-sheet" data-sheet-toggle>
        <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M0 2H14M3 6H11M5.5 10H8.5"></path>
        </svg>
        <span data-sheet-label>Filters</span>
      </button>
      <span class="text-muted font-mono text-[11px] whitespace-nowrap" data-shown-short></span>
      <div class="relative" data-dropdown="sort-sm">
        <button type="button" class={triggerClass} aria-expanded="false" aria-controls="menu-sort-sm" data-trigger>
          <span data-sort-short>Newest</span>
          <span aria-hidden="true">▾</span>
        </button>
        <div id="menu-sort-sm" role="group" aria-label="Sort projects" class={`${menuClass} right-0 min-w-50`} hidden data-menu>
          {
            sorts.map((o) => (
              <button type="button" class={optionClass} data-sort={o.value} aria-pressed="false">
                {o.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div
      id="filter-sheet"
      hidden
      class="border-line-strong bg-card absolute inset-x-0 top-full z-40 flex flex-col gap-5.5 border-t border-b px-6 pt-5 pb-6 shadow-[0_24px_40px_-20px_rgba(0,0,0,0.6)]"
    >
      {
        groups.map((g) => (
          <fieldset class="m-0 border-0 p-0">
            <legend class="label mb-2.5 p-0 text-[10px]">{g.label}</legend>
            <div class="flex flex-wrap gap-1.5">
              {[{ value: "", label: "All" }, ...g.options].map((o) => (
                <button
                  type="button"
                  data-filter={g.key}
                  data-value={o.value}
                  aria-pressed="false"
                  class="border-control text-text aria-pressed:bg-text aria-pressed:text-bg aria-pressed:border-text cursor-pointer border bg-transparent px-3 py-2.25 font-mono text-xs whitespace-nowrap disabled:cursor-default disabled:opacity-40"
                >
                  {o.label} <span class="opacity-60" data-count />
                </button>
              ))}
            </div>
          </fieldset>
        ))
      }
      <div class="flex gap-2">
        <button type="button" class="btn" data-clear-all>Clear</button>
        <button type="button" class="btn btn-primary flex-1" data-sheet-close>
          <span data-sheet-done>Show projects</span>
        </button>
      </div>
    </div>
  </div>
</div>

<section class="border-line border-b">
  <div class="container pt-12 pb-28 max-[720px]:pb-16">
    <ul id="project-grid" class="m-0 grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <li
            class="flex [&>a]:flex-1"
            data-industry={p.data.industry ?? ""}
            data-service={p.data.services.map((s) => s.slug).join("|")}
            data-tech={p.data.tags.join("|")}
            data-date={p.data.postDate.toISOString()}
            data-title={p.data.title}
          >
            <ProjectCard project={p} loading={i < 3 ? "eager" : "lazy"} />
          </li>
        ))
      }
    </ul>
    <div id="project-empty" hidden class="border-line border border-dashed px-6 py-16 text-center">
      <p class="text-body mt-0 mb-5">No projects match these filters yet.</p>
      <button type="button" class="btn" data-clear-all>Show all projects</button>
    </div>
  </div>
</section>

<script>
  type Key = "industry" | "service" | "tech";
  const keys: Key[] = ["industry", "service", "tech"];
  const labels: Record<Key, string> = { industry: "Industry", service: "Service", tech: "Tech" };
  const sortLabels: Record<string, string> = {
    newest: "Newest",
    oldest: "Oldest",
    az: "Name A–Z",
    za: "Name Z–A",
  };
  const state: Record<Key, string> & { sort: string } = {
    industry: "",
    service: "",
    tech: "",
    sort: "newest",
  };

  const root = document.getElementById("project-filters")!;
  const grid = document.getElementById("project-grid")!;
  const empty = document.getElementById("project-empty")!;
  const items = Array.from(grid.querySelectorAll<HTMLLIElement>(":scope > li"));
  const sheet = document.getElementById("filter-sheet")!;
  const sheetToggle = root.querySelector<HTMLButtonElement>("[data-sheet-toggle]")!;

  const matches = (li: HTMLLIElement, s: Record<Key, string>) =>
    keys.every((k) => !s[k] || (li.dataset[k] ?? "").split("|").includes(s[k]));

  const compare: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
    newest: (a, b) => b.dataset.date!.localeCompare(a.dataset.date!),
    oldest: (a, b) => a.dataset.date!.localeCompare(b.dataset.date!),
    az: (a, b) => a.dataset.title!.localeCompare(b.dataset.title!),
    za: (a, b) => b.dataset.title!.localeCompare(a.dataset.title!),
  };

  const render = () => {
    const visible = items.filter((li) => matches(li, state));
    items.forEach((li) => (li.hidden = !visible.includes(li)));
    [...items].sort(compare[state.sort]).forEach((li) => grid.append(li));
    empty.hidden = visible.length > 0;

    // Options: pressed state, and a count of projects each one would show
    root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) => {
      const key = btn.dataset.filter as Key;
      const value = btn.dataset.value ?? "";
      const on = state[key] === value;
      const count = items.filter((li) => matches(li, { ...state, [key]: value })).length;
      btn.setAttribute("aria-pressed", String(on));
      btn.disabled = count === 0 && !on;
      const c = btn.querySelector("[data-count]");
      if (c) c.textContent = String(count);
    });
    root.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.sort === state.sort));
    });

    keys.forEach((k) => {
      const label = root.querySelector(`[data-dropdown="${k}"] [data-trigger-label]`);
      const option = root.querySelector(`[data-filter="${k}"][data-value="${CSS.escape(state[k])}"]`);
      const name = state[k] ? option?.firstChild?.textContent?.trim() : "All";
      if (label) label.textContent = `${labels[k]}: ${name}`;
    });
    const sortLabel = root.querySelector('[data-dropdown="sort"] [data-trigger-label]');
    if (sortLabel) sortLabel.textContent = `Sort: ${sortLabels[state.sort]}`;
    root.querySelector("[data-sort-short]")!.textContent = sortLabels[state.sort];

    const active = keys.filter((k) => state[k]).length;
    root.querySelector<HTMLButtonElement>("[data-clear]")!.hidden = active === 0;
    root.querySelector("[data-sheet-label]")!.textContent = active ? `Filters · ${active}` : "Filters";
    root.querySelector("[data-sheet-done]")!.textContent =
      `Show ${visible.length} project${visible.length === 1 ? "" : "s"}`;
    root.querySelector("[data-shown]")!.textContent = `${visible.length} / ${items.length} shown`;
    root.querySelector("[data-shown-short]")!.textContent = `${visible.length} / ${items.length}`;
  };

  // ── Dropdowns ────────────────────────────────────────────────
  const dropdowns = Array.from(root.querySelectorAll<HTMLElement>("[data-dropdown]"));
  const closeAll = (except?: HTMLElement) =>
    dropdowns.forEach((d) => {
      if (d === except) return;
      d.querySelector<HTMLElement>("[data-menu]")!.hidden = true;
      d.querySelector("[data-trigger]")!.setAttribute("aria-expanded", "false");
    });

  dropdowns.forEach((d) => {
    const trigger = d.querySelector<HTMLButtonElement>("[data-trigger]")!;
    const menu = d.querySelector<HTMLElement>("[data-menu]")!;
    trigger.addEventListener("click", () => {
      const open = menu.hidden;
      closeAll(d);
      menu.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      if (open) menu.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
    });
  });

  const setSheet = (open: boolean) => {
    sheet.hidden = !open;
    sheetToggle.setAttribute("aria-expanded", String(open));
  };

  root.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
    if (!btn) return;
    if (btn.dataset.filter) {
      state[btn.dataset.filter as Key] = btn.dataset.value ?? "";
      render();
      // Desktop menus close on pick; the phone panel stays open
      const dd = btn.closest<HTMLElement>("[data-dropdown]");
      if (dd) {
        closeAll();
        dd.querySelector<HTMLButtonElement>("[data-trigger]")!.focus();
      }
    } else if (btn.dataset.sort) {
      state.sort = btn.dataset.sort;
      render();
      closeAll();
      btn.closest("[data-dropdown]")?.querySelector<HTMLButtonElement>("[data-trigger]")?.focus();
    } else if (btn.hasAttribute("data-clear")) {
      keys.forEach((k) => (state[k] = ""));
      render();
    } else if (btn.hasAttribute("data-sheet-toggle")) {
      closeAll();
      setSheet(Boolean(sheet.hidden));
    } else if (btn.hasAttribute("data-sheet-close")) {
      setSheet(false);
      sheetToggle.focus();
    }
  });

  document.querySelectorAll("[data-clear-all]").forEach((btn) =>
    btn.addEventListener("click", () => {
      keys.forEach((k) => (state[k] = ""));
      render();
    }),
  );

  document.addEventListener("click", (e) => {
    if (!root.contains(e.target as Node)) {
      closeAll();
      setSheet(false);
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const openDd = dropdowns.find((d) => !d.querySelector<HTMLElement>("[data-menu]")!.hidden);
    if (openDd) {
      closeAll();
      openDd.querySelector<HTMLButtonElement>("[data-trigger]")!.focus();
    } else if (!sheet.hidden) {
      setSheet(false);
      sheetToggle.focus();
    }
  });

  render();
</script>
