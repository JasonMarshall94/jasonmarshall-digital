---
import type { Mark } from "astro-portabletext/types";

interface Props {
  node: Mark<{ href: string }>;
}
const { node } = Astro.props;
const href = node.markDef.href;
// Links to other sites open in a new tab; site paths, mailto: and tel: don't
const external = /^https?:\/\//.test(href) && !href.includes("jasonmarshall.digital");
---

<a
  href={href}
  {...external && { target: "_blank", rel: "noopener noreferrer" }}
  ><slot /></a
>
