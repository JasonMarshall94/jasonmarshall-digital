---
export interface Crumb {
  label: string;
  /** Omit for the current page */
  href?: string;
}

interface Props {
  heading: string;
  /** Short mono line under the heading, e.g. "Web designer & developer" */
  subline?: string | null;
  intro?: string | null;
  /** Trail after Home, ending with the current page */
  breadcrumbs: Crumb[];
}
const { heading, subline, intro, breadcrumbs } = Astro.props;
---

<section class="border-line relative overflow-hidden border-b">
  <div class="gridlines"></div>
  <div class="relative z-2 container pt-12 pb-16">
    <nav aria-label="Breadcrumb" class="float-in">
      <ol class="label m-0 flex list-none flex-wrap items-center gap-2.5 p-0">
        <li><a href="/" class="text-faint hover:text-text">Home</a></li>
        {
          breadcrumbs.map((c) => (
            <li class="flex items-center gap-2.5">
              <span class="text-line-strong" aria-hidden="true">
                /
              </span>
              {c.href ? (
                <a href={c.href} class="text-faint hover:text-text">
                  {c.label}
                </a>
              ) : (
                <span aria-current="page" class="text-muted">
                  {c.label}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <h1
      class="text-text float-in mt-9 mb-0 max-w-[22ch] text-[clamp(40px,5vw,60px)] leading-none font-medium tracking-[-0.04em] text-balance"
      style="animation-delay: 0.1s"
    >
      {heading}
    </h1>
    {
      subline && (
        <p class="subline float-in mt-3.5 mb-0" style="animation-delay: 0.15s">
          {subline}
        </p>
      )
    }
    {
      intro && (
        <p
          class="text-body float-in mt-6 mb-0 max-w-[540px] text-lg leading-[1.65]"
          style="animation-delay: 0.2s"
        >
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</section>
